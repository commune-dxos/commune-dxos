# Cấu hình app di động (cp .env.example .env). Bỏ trống = dùng bản demo công khai.
# Không có bí mật: client Keycloak là public + PKCE.
#
# Máy local (make up ở gốc repo) trên máy ảo Android: chạy
#   adb reverse tcp:9080 tcp:9080 && adb reverse tcp:8080 tcp:8080
# rồi đặt hai địa chỉ dưới đây là http://localhost:9080 và http://localhost:8080.
DXOS_GATEWAY_URL=https://commune.dzfullstack.com
DXOS_KEYCLOAK_URL=https://commune.dzfullstack.com
DXOS_KEYCLOAK_REALM=dxos
DXOS_OIDC_CLIENT_ID=mot_cua_di_dong
