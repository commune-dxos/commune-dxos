{
  "roles": {
    "client": {
      "dxos_api": [
        {
          "name": "cong_dan",
          "description": "mot-cua: công dân. Trùng tên role PostgreSQL cong_dan"
        },
        {
          "name": "can_bo",
          "description": "mot-cua: cán bộ một cửa / chuyên môn. Bắt buộc MFA (OTP). Trùng role PostgreSQL can_bo"
        },
        {
          "name": "lanh_dao",
          "description": "mot-cua: lãnh đạo xã. Bắt buộc MFA (OTP). Trùng role PostgreSQL lanh_dao"
        },
        {
          "name": "dich_vu_tep",
          "description": "mot-cua: tài khoản dịch vụ của API tệp (backend), chỉ ghi metadata tệp đã quét và nhật ký tệp. Không gán cho người. Trùng role PostgreSQL dich_vu_tep"
        },
        {
          "name": "dich_vu_su_kien",
          "description": "mot-cua: tài khoản dịch vụ sự kiện (#9) của mot-cua-api/mot-cua-worker: ghi hộp thư đi sự kiện, đọc cột hồ sơ không phải dữ liệu cá nhân, ghi nhật ký sự kiện. Không gán cho người. Trùng role PostgreSQL dich_vu_su_kien"
        },
        {
          "name": "dich_vu_danh_muc",
          "description": "mot-cua: tài khoản dịch vụ của bộ nạp gói thủ tục (nap-thu-tuc, D-009): chỉ gọi RPC nạp/rút gói vào danh mục thủ tục. Không gán cho người. Trùng role PostgreSQL dich_vu_danh_muc"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "cong-dan",
      "path": "/cong-dan",
      "clientRoles": {
        "dxos_api": [
          "cong_dan"
        ]
      }
    },
    {
      "name": "can-bo",
      "path": "/can-bo",
      "clientRoles": {
        "dxos_api": [
          "can_bo"
        ]
      }
    },
    {
      "name": "lanh-dao",
      "path": "/lanh-dao",
      "clientRoles": {
        "dxos_api": [
          "lanh_dao"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "mot_cua_web",
      "name": "mot-cua: cổng công dân và cổng cán bộ (React)",
      "description": "Public client, Authorization Code + PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:9080/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:9080",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:9080/*##http://localhost:5173/*"
      },
      "protocol": "openid-connect"
    },
    {
      "clientId": "mot_cua_tep",
      "name": "mot-cua: API tệp (backend, tài khoản dịch vụ)",
      "description": "Confidential client, chỉ Client Credentials. Keycloak sinh client secret khi nạp; tang2-realm ghi secret vào OpenBao (dxos/tang2/mot-cua/keycloak/mot_cua_tep) cho mot-cua-api.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "mot_cua_su_kien",
      "name": "mot-cua: sự kiện hồ sơ (backend, tài khoản dịch vụ)",
      "description": "Confidential client, chỉ Client Credentials. Keycloak sinh client secret khi nạp; tang2-realm ghi secret vào OpenBao (dxos/tang2/mot-cua/keycloak/mot_cua_su_kien) cho mot-cua-api, mot-cua-worker.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "mot_cua_danh_muc",
      "name": "mot-cua: bộ nạp gói thủ tục (tài khoản dịch vụ)",
      "description": "Confidential client, chỉ Client Credentials. Keycloak sinh client secret khi nạp; tang2-realm ghi secret vào OpenBao (dxos/tang2/mot-cua/keycloak/mot_cua_danh_muc) cho nap-thu-tuc.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
