# Header bảo mật của cổng công dân (#57), default.conf include ở mức server và trong mọi location
# có add_header riêng (nginx không kế thừa add_header khi location tự khai).
# CSP: không 'unsafe-inline', không 'unsafe-eval'; script, style, phông chỉ từ chính origin
# (Be Vietnam Pro tự host). Trình duyệt gọi Keycloak (discovery, token, làm mới phiên) nên
# DXOS_KEYCLOAK_URL có trong connect-src, frame-src, form-action. Không cho nhúng trang vào frame.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${DXOS_KEYCLOAK_URL}; frame-src ${DXOS_KEYCLOAK_URL}; form-action 'self' ${DXOS_KEYCLOAK_URL}; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "same-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
