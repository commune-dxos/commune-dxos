# Biến build của cổng công dân (Vite chỉ đưa biến VITE_* vào mã chạy trên trình duyệt).
# Mọi giá trị ở đây là công khai: KHÔNG đặt bí mật nào (client mot_cua_web, mot_cua_can_bo là public + PKCE).
# Chép thành .env.local để đổi khi chạy dev; mặc định khớp .env.example ở gốc repo.

# API Gateway (APISIX). Web chỉ gọi lõi qua đây: /public, /api, /workflow, /files.
VITE_GATEWAY_URL=http://localhost:9080
# Keycloak (SSO) mà trình duyệt thấy, realm và client public của Tầng 2.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=dxos
VITE_OIDC_CLIENT_ID=mot_cua_web
# Client public của cổng cán bộ /can-bo (#55).
VITE_OIDC_CLIENT_ID_CAN_BO=mot_cua_can_bo
# 1 = dùng dữ liệu giả trong src/du-lieu-gia/ thay cho gọi APISIX (xem giao diện khi chưa chạy
# make up). `npm run dev:gia` bật sẵn qua tệp .env.du-lieu-gia.
VITE_DU_LIEU_GIA=0
