# SPDX-License-Identifier: Apache-2.0
# Mẫu cấu hình. Sao chép: cp .env.example .env rồi ĐỔI mọi mật khẩu.
# Không commit .env. Các giá trị dưới đây chỉ là chỗ giữ, không phải mật khẩu thật.

# --- Ứng dụng Tầng 2 ------------------------------------------------------------
# Tên thư mục trong apps/ mà lõi nạp (migration SQL, vai trò Keycloak, cấu hình PostgREST).
DXOS_APP=mot-cua
# Nạp dữ liệu mẫu GIẢ trong apps/<DXOS_APP>/db/seed/. Đặt false khi triển khai thật.
DXOS_SEED=true

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=commune
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi-mat-khau-postgres
# Cổng mở trên 127.0.0.1 để debug bằng psql (55432 để không đụng PostgreSQL cài sẵn trên máy)
POSTGRES_PORT=55432

# Mật khẩu role `authenticator` mà PostgREST dùng để đăng nhập.
# Chỉ dùng chữ, số, dấu gạch: giá trị nằm trong URI kết nối.
PGRST_DB_PASSWORD=doi-mat-khau-postgrest

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_DB_PASSWORD=doi-mat-khau-keycloak-db
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=doi-mat-khau-quan-tri-keycloak
KEYCLOAK_PORT=8080

# --- APISIX ------------------------------------------------------------------
APISIX_PORT=9080

# --- Flowable (workflow engine) ---------------------------------------------------
# Mật khẩu role `flowable` trong PostgreSQL (CSDL riêng `flowable`, do flowable-db-init tạo).
FLOWABLE_DB_PASSWORD=doi-mat-khau-flowable-db
# Mật khẩu tài khoản REST `rest-admin` của Flowable (Basic auth).
FLOWABLE_ADMIN_PASSWORD=doi-mat-khau-quan-tri-flowable
# Cổng debug trên 127.0.0.1; Tầng 2 gọi qua APISIX.
FLOWABLE_PORT=8090

# --- Web Tầng 2 ----------------------------------------------------------------------
# Origin web được gọi API qua APISIX từ trình duyệt (CORS), cách nhau bởi dấu phẩy.
DXOS_CORS_ORIGINS=http://localhost:5173

# --- Tệp hồ sơ: Garage (S3) + ClamAV (#7) ---------------------------------------------------
# Không có khóa hay mật khẩu nào ở đây: bí mật Garage và khóa S3 của ứng dụng được sinh lúc
# khởi tạo vào volume Docker (garage-secrets, app-secrets), xem docs/architecture.md.
# Dung lượng khai báo cho nút Garage trong layout (byte).
GARAGE_CAPACITY_BYTES=10737418240
# Địa chỉ gateway mà client dùng; link tải ký ngắn hạn có dạng ${DXOS_GATEWAY_URL}/files/s3/…
DXOS_GATEWAY_URL=http://localhost:9080
# Kích thước tối đa một tệp (byte). Gateway chặn ở 10 MiB (core/apisix/apisix.yaml), không đặt cao hơn.
DXOS_FILE_MAX_BYTES=10485760
# Thời hạn tối đa (giây) của link xem tệp đã ký.
DXOS_FILE_LINK_TTL=300
