# Mẫu cấu hình. Sao chép: cp .env.example .env. Không commit .env.
#
# Tệp này KHÔNG chứa bí mật (#10): mọi mật khẩu, khóa, token nằm trong OpenBao, do bao-init
# sinh ngẫu nhiên lần đầu `make up` (docs/architecture.md §4.4). Đã chuyển khỏi .env:
#   POSTGRES_PASSWORD        → OpenBao dxos/core/db/postgres
#   PGRST_DB_PASSWORD        → dxos/core/db/authenticator
#   KEYCLOAK_DB_PASSWORD     → dxos/core/db/keycloak
#   KEYCLOAK_ADMIN_PASSWORD  → dxos/core/keycloak/admin
#   FLOWABLE_DB_PASSWORD     → dxos/core/db/flowable
#   FLOWABLE_ADMIN_PASSWORD  → dxos/core/flowable/rest-admin
# .env cũ còn các dòng trên: lần `make up` đầu tiên chuyển giá trị sang OpenBao (giữ được
# volume cũ), sau đó XÓA các dòng đó khỏi .env. Xem bí mật: docs/architecture.md §4.4.6.

# --- Bộ máy một cửa (Tầng 2) ------------------------------------------------------
# Thủ tục hành chính cắm vào bằng thư mục thu-tuc/<ma>/ (docs/thu-tuc.md), không qua biến nào.
# Nạp dữ liệu mẫu GIẢ trong mot-cua/db/seed/. Đặt false khi triển khai thật.
DXOS_SEED=true
# Ký số giấy tờ (#77): tên cơ quan in trên biên nhận/kết quả và là tên chủ thể chứng thư ký tài liệu
# (đổi tên → make up cấp chứng thư mới). Tên CA nội bộ chỉ áp dụng khi khởi tạo CA lần đầu.
DXOS_KY_SO_TEN="UBND xã Mẫu – Bộ phận Một cửa"
DXOS_CA_TEN="CA nội bộ Commune DX-OS"
# Thời hạn chứng thư ký tài liệu (giờ); ca-init gia hạn khi còn dưới 30 ngày.
DXOS_KY_SO_THOI_HAN=8760h

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=commune
POSTGRES_USER=postgres
# Cổng mở trên 127.0.0.1 để debug bằng psql (55432 để không đụng PostgreSQL cài sẵn trên máy)
POSTGRES_PORT=55432
# pgAudit (#75): lớp câu lệnh ghi log kiểm toán phiên, ví dụ ddl,role (mặc định) hoặc ddl,role,write.
# Truy cập bảng có dữ liệu cá nhân luôn được ghi (log đối tượng, role dxos_kiem_toan).
DXOS_PGAUDIT_LOG=ddl,role

# --- Keycloak ----------------------------------------------------------------
# Tên tài khoản quản trị khởi tạo của Keycloak (mật khẩu ở OpenBao).
KEYCLOAK_ADMIN=admin
KEYCLOAK_PORT=8080

# --- APISIX ------------------------------------------------------------------
APISIX_PORT=9080

# --- Flowable (workflow engine) ---------------------------------------------------
# Cổng debug trên 127.0.0.1; Tầng 2 gọi qua APISIX.
FLOWABLE_PORT=8090

# --- Web Tầng 2 ----------------------------------------------------------------------
# Origin web được gọi API qua APISIX từ trình duyệt (CORS), cách nhau bởi dấu phẩy.
# Origin của gateway (DXOS_GATEWAY_URL, nơi APISIX phục vụ cổng công dân, #57) luôn được thêm,
# không cần ghi ở đây. http://localhost:5173: `npm run dev` trong mot-cua/web-cong-dan/.
DXOS_CORS_ORIGINS=http://localhost:5173

# --- Tệp hồ sơ: Garage (S3) + ClamAV (#7) ---------------------------------------------------
# Bí mật Garage (rpc_secret, admin_token) và khóa S3 của bộ máy một cửa nằm trong OpenBao.
# Dung lượng khai báo cho nút Garage trong layout (byte).
GARAGE_CAPACITY_BYTES=10737418240
# Địa chỉ gateway mà client dùng; link tải ký ngắn hạn có dạng ${DXOS_GATEWAY_URL}/files/s3/…
DXOS_GATEWAY_URL=http://localhost:9080
# Kích thước tối đa một tệp (byte). Gateway chặn ở 10 MiB (nen-tang/apisix/apisix.yaml), không đặt cao hơn.
DXOS_FILE_MAX_BYTES=10485760
# Thời hạn tối đa (giây) của link xem tệp đã ký.
DXOS_FILE_LINK_TTL=300

# --- OpenBao: két sắt bí mật (#10) --------------------------------------------------------
# Thư mục TRÊN MÁY chứa unseal key + root token (tệp <tên compose project>.json, quyền 600).
# Nằm trong .data/ (đã .gitignore). KHÔNG xóa, KHÔNG commit: mất tệp khi OpenBao đang seal
# = mất mọi bí mật. Sao lưu ra nơi an toàn ngoài repo.
BAO_INIT_DIR=./.data/openbao
# file: bao-init tự unseal bằng tệp khóa trên — CHỈ DÙNG CHO MÁY DEV.
# manual: không tự unseal; unseal tay bằng `docker compose exec openbao bao operator unseal`.
BAO_UNSEAL=file
# Số phần khóa Shamir khi init lần đầu và số phần cần để unseal.
BAO_KEY_SHARES=1
BAO_KEY_THRESHOLD=1

# --- RabbitMQ: hàng đợi sự kiện (#9) -------------------------------------------------------
# Tên tài khoản quản trị khởi tạo của RabbitMQ (mật khẩu ở OpenBao dxos/core/rabbitmq/admin).
# User của bộ máy (tang2-mot-cua) do rabbitmq-init tạo, mật khẩu ở dxos/tang2/mot-cua/rabbitmq.
RABBITMQ_ADMIN=admin
# mot-cua-worker quét hồ sơ sắp trễ hạn mỗi bao nhiêu giây.
DXOS_SU_KIEN_QUET_GIAY=300
# Cảnh báo ho_so.sap_tre_han khi còn ≤ bấy nhiêu ngày làm việc tới hạn xử lý.
DXOS_SU_KIEN_SAP_TRE_NGAY=1
# Đối soát trạng thái hồ sơ với Flowable (#73, cùng vòng quét): bỏ qua hồ sơ vừa đổi bước trong
# bấy nhiêu giây (mot-cua-api có thể đang ghi), xét tối đa bấy nhiêu hồ sơ chưa đóng mỗi vòng.
DXOS_DOI_SOAT_CHO_GIAY=60
DXOS_DOI_SOAT_TOI_DA=500
# Thông báo sắp trễ hạn tới cán bộ (#56): luôn có trong cổng cán bộ; kênh ngoài liệt kê ở đây (email, sms,
# cách nhau bởi dấu phẩy, để trống = không) chỉ chạy ở chế độ giả lập: ghi CSDL và log, không gửi thật.
DXOS_THONG_BAO_KENH=email,sms

# --- Trợ lý thủ tục hành chính (RAG, #91) --------------------------------------------------
# Nhà cung cấp mô hình (mot-cua/backend/mo_hinh.py):
#   tat                chỉ tìm kiếm Meilisearch, không mô hình (mặc định: chạy được trên mọi máy)
#   ollama             Qwen2.5 7B + bge-m3 qua Ollama: make up-ai (tải khoảng 6 GB lần đầu)
#   openai-compatible  API ngoài chuẩn OpenAI tại LLM_BASE_URL (ví dụ https://…/v1); khóa API (nếu cần) đặt
#                      trong OpenBao dxos/tang2/mot-cua/llm (trường api_key), KHÔNG đặt ở đây (docs/cai-dat.md)
#   gia-lap            không tải mô hình, câu trả lời trích nguyên văn (CI, smoke)
LLM_PROVIDER=tat
# Để trống: ollama dùng http://ollama:11434 (profile ai). Ollama chạy trên máy (Mac dùng GPU):
# http://host.docker.internal:11434
LLM_BASE_URL=
# Chỉ mô hình giấy phép OSI: Qwen2.5 Apache-2.0 (0.5B/1.5B/7B/14B/32B; KHÔNG 3B, 72B), không Llama, Gemma.
LLM_MODEL=qwen2.5:7b
# Mô hình nhúng 1024 chiều (bge-m3, MIT). Đổi mô hình nhúng thì chạy make nap-tri-thuc để nhúng lại.
LLM_EMBED_MODEL=bge-m3
# Giây tối đa cho một lần gọi mô hình. Qwen2.5 7B chạy CPU trong Docker mất khoảng 1–2 phút một câu trả lời;
# APISIX chờ /tro-ly/hoi tối đa 180 giây nên giữ dưới 180. Quá giờ → trả tài liệu liên quan kèm thông báo.
LLM_TIMEOUT=170
# Số câu hỏi được sinh trả lời cùng lúc; quá thì trả kết quả tìm kiếm kèm thông báo "đang bận".
TRO_LY_DONG_THOI=2
